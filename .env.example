# Copy to `.env` in the repo root, then: docker compose up --build
#
# Local one-command (HTTP). Invite / reset URLs print in `docker compose logs api`
# when SMTP is unset.

NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
DATABASE_URL=postgresql://relay:relay@db:5432/relay
TOKEN_SECRET=change-me-to-long-random
TOKEN_ISSUER=relay
TOKEN_AUDIENCE=relay-web
# ACCESS_TOKEN_VALIDITY_SEC=900
# REFRESH_TOKEN_VALIDITY_SEC=86400

# Production (HTTPS). Rebuild web after changing NEXT_PUBLIC_API_URL.
# NODE_ENV=production
# TRUST_PROXY=1
# WEB_ORIGIN=https://relay.example.com
# NEXT_PUBLIC_API_URL=https://api.example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Relay <noreply@example.com>

# S3-compatible storage (Compose sets MinIO endpoints on the api service).
# For AWS: omit S3_ENDPOINT / S3_PUBLIC_ENDPOINT or use the regional S3 URL.
# For Backblaze: S3_ENDPOINT=https://s3.<region>.backblazeb2.com and path-style true.
# S3_ACCESS_KEY=relay
# S3_SECRET_KEY=relayrelay
# S3_REGION=us-east-1
# S3_BUCKET=relay
# S3_FORCE_PATH_STYLE=true
