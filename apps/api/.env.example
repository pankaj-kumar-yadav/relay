# Local pnpm API — copy to `.env`
# Docker Compose also loads this file (overrides DATABASE_URL host to `db`).

# --- App ---
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
# TRUST_PROXY=1

# --- Database ---
# Host is localhost for pnpm (Postgres on host / published port).
DATABASE_URL=postgresql://relay:relay@localhost:5432/relay

# --- Auth ---
TOKEN_SECRET=change-me-to-long-random
TOKEN_ISSUER=relay
TOKEN_AUDIENCE=relay-web
# ACCESS_TOKEN_VALIDITY_SEC=900
# REFRESH_TOKEN_VALIDITY_SEC=86400

# --- Storage (S3) ---
# Unset → STORAGE_UNCONFIGURED
# S3_ENDPOINT=https://s3.eu-north-1.amazonaws.com
# S3_PUBLIC_ENDPOINT=https://s3.eu-north-1.amazonaws.com
# S3_REGION=eu-north-1
# S3_BUCKET=relay-development-storage
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_FORCE_PATH_STYLE=false

# --- Email (optional) ---
# API logs invite/reset links if unset
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Relay <noreply@example.com>
