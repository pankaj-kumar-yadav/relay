NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://relay:relay@localhost:5432/relay
TOKEN_SECRET=change-me-to-long-random
TOKEN_ISSUER=relay
TOKEN_AUDIENCE=relay-web
# ACCESS_TOKEN_VALIDITY_SEC=900
# REFRESH_TOKEN_VALIDITY_SEC=86400

# Production (HTTPS, behind nginx/load balancer):
# NODE_ENV=production
# TRUST_PROXY=1
# WEB_ORIGIN=https://relay.example.com

# SMTP (optional in development — the API logs the link if unset)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Relay <noreply@example.com>

# S3-compatible storage (optional for pnpm dev — uploads return STORAGE_UNCONFIGURED if unset)
# Use local MinIO (docker compose up minio minio-init) or AWS / Backblaze.
# S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=relay
# S3_ACCESS_KEY=relay
# S3_SECRET_KEY=relayrelay
# S3_FORCE_PATH_STYLE=true

# Seed users (pnpm --filter @relay/api db:seed), password: password
# owner@relay.local → acme (super-admin)
# admin@techap.local / employee@techap.local → techap-solutions
# admin@stratxg.local / employee@stratxg.local → stratxg
